# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME=OpenGraphKB
DEBUG=true
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# ── Neo4j ────────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme_neo4j

# ── Qdrant ───────────────────────────────────────────────────────────────────
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=opengraphkb

# ── LLM Provider ─────────────────────────────────────────────────────────────
LLM_PROVIDER=openai
LLM_API_KEY=sk-...
LLM_BASE_URL=https://api.openai.com/v1
LLM_CHAT_MODEL=gpt-4o
LLM_EMBEDDING_MODEL=text-embedding-3-small
LLM_EMBEDDING_DIMENSIONS=1536

# ── Storage ──────────────────────────────────────────────────────────────────
STORAGE_BASE_PATH=./data

# ── Ingestion ────────────────────────────────────────────────────────────────
ENABLE_GRAPH_EXTRACTION=true
ENABLE_CHUNK_ENTITY_EXTRACTION=true
CHUNKING_STRATEGY=fixed_size
CHUNK_SIZE=1000
CHUNK_OVERLAP=100

# ── Entity Schema (comma-separated) ─────────────────────────────────────────
ENTITY_TYPES=Person,Organization,Project,Topic,Event,Technology,Location
RELATIONSHIP_TYPES=MENTIONS,BELONGS_TO,RELATES_TO,LEADS,PRODUCES,LOCATED_IN,PART_OF
